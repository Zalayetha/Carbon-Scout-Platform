# Database (PostgreSQL with Drizzle ORM)
DATABASE_URL="postgres://anvia:anvia@localhost:5433/anvia"

# Model Provider (OpenAI or OpenRouter)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://gateway.devscale.id/v1"
OPENROUTER_API_KEY="your-openrouter-api-key"

# Research & Web Intelligence
TAVILY_API_KEY="your-tavily-api-key"
# USE_MOCK_SERVICES="false"

# Anvia Lens Observability (Optional)
ANVIA_LENS_BASE_URL="http://localhost:3000"
ANVIA_LENS_PUBLIC_KEY="your-lens-public-key"
ANVIA_LENS_SECRET_KEY="your-lens-secret-key"

# LLM provider: "devscale" (uses OPENAI_API_KEY + OPENAI_BASE_URL) or "openrouter" (uses OPENROUTER_API_KEY)
LLM_PROVIDER="devscale"
# Optional model override, e.g. "gpt-6-luna" (devscale) or "openai/gpt-6-luna" (openrouter)
# LLM_MODEL_ID=""
