{
  "name": "zalsoft-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "pnpm monorepo workspace",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter platform run dev",
    "api:dev": "pnpm --filter api run dev",
    "platform:dev": "pnpm --filter platform run dev",
    "logger:build": "pnpm --filter logger run build",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "pnpm --recursive run typecheck",
    "build": "pnpm --recursive run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
