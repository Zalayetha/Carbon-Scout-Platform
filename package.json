{
  "name": "zalsoft-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "pnpm monorepo workspace",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter platform run dev",
    "api:dev": "pnpm --filter api run dev",
    "platform:dev": "pnpm --filter platform run dev",
    "logger:build": "pnpm --filter logger run build",
    "db:generate": "pnpm --filter @anvia/db run db:generate",
    "db:migrate": "pnpm --filter @anvia/db run db:migrate",
    "db:push": "pnpm --filter @anvia/db run db:push",
    "db:studio": "pnpm --filter @anvia/db run db:studio",
    "eval": "pnpm --filter @anvia/agents run eval",
    "eval:contain": "pnpm --filter @anvia/agents run eval:contain",
    "eval:abstention": "pnpm --filter @anvia/agents run eval:abstention",
    "eval:exact-match": "pnpm --filter @anvia/agents run eval:exact-match",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "pnpm --recursive run typecheck",
    "build": "pnpm --recursive run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.10.1"
}
